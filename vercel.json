{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/solution",
      "destination": "/api/index?route=solution"
    },
    {
      "source": "/api/preview/:id",
      "destination": "/api/index?route=preview&id=:id"
    },
    {
      "source": "/preview/:id",
      "destination": "/api/index?route=preview&id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
