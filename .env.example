# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Gemini Flash with High Reasoning/Thinking)
# Default is gemini-2.5-flash or your desired model identifier
GEMINI_MODEL=gemini-2.5-flash

# Optional secret token to verify Telegram webhook requests
WEBHOOK_SECRET=your_optional_secret_here
